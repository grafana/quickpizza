# Reference for the variables compose.yaml understands.
#
# Docker Compose only auto-loads a file named ".env", so copy this to .env if you
# want these applied automatically, or pass them inline:
#   GRAFANA_PORT=3001 make up

# Host ports. Change these if something already uses the defaults.
# QUICKPIZZA_PORT=3333
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Use a locally built image instead of the published one:
#   make docker-build
# QUICKPIZZA_IMAGE=local-quickpizza:latest

# Override the Grafana version.
# GRAFANA_VERSION=13.0.1
